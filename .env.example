# Aarohanam - Vedic Time Companion (Ayan OS) Configuration Template
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=postgresql://vedic_user:vedic_password@localhost:5432/vedic_clock_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration (use a strong random secret in production)
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Settings
APP_NAME=Aarohanam - Vedic Time Companion
DEBUG=True
LOG_LEVEL=info

# Default Location (Delhi, India)
DEFAULT_LATITUDE=28.6139
DEFAULT_LONGITUDE=77.209
DEFAULT_ELEVATION=216
DEFAULT_TIMEZONE=Asia/Kolkata
